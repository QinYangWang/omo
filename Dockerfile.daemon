# omo v2 daemon (packages/daemon). No Web build is required: the daemon only
# serves the /v1 protocol (HTTP + WSS). Provider credentials come from the
# mounted pi auth store (~/.pi/agent) — see docs/daemon.md.
FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    OMO_DAEMON_HOST=0.0.0.0 \
    OMO_DAEMON_PORT=5190 \
    OMO_DAEMON_DATA_DIR=/data \
    OMO_WORKSPACE_ROOTS=/workspace
WORKDIR /app
# node-pty build fallback (prebuilds are used when available).
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force && apt-get purge -y --auto-remove python3 make g++
COPY packages ./packages
RUN mkdir -p /data /workspace
EXPOSE 5190
CMD ["node", "--no-warnings", "packages/daemon/bin/omo-daemon.ts"]
