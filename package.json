{
  "name": "omo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "omo": "cli/omo.mjs"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' -r build && tsc -b && vite build",
    "check": "ultracite check",
    "dev": "pnpm --filter @omo/client-core... build && vite",
    "dev:desktop": "concurrently -k \"pnpm --filter @omo/client-core... build && vite\" \"wait-on http://localhost:5188 && electron .\"",
    "dev:web": "pnpm --filter @omo/client-core... build && vite",
    "fix": "ultracite fix",
    "omo": "node cli/omo.mjs",
    "omo:dev": "pnpm --filter @omo/client-core... build && node cli/omo.mjs",
    "prepare": "pnpm --filter @omo/client-core... build",
    "restart:web": "bash scripts/restart-web-server.sh",
    "server": "pnpm --filter './packages/**' -r build && node server/index.cjs",
    "server:dev": "pnpm --filter './packages/**' -r build && node --watch server/index.cjs",
    "start": "electron .",
    "test": "pnpm --filter './packages/**' -r build && pnpm --filter './packages/**' -r test && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@omo/client-core": "workspace:*",
    "@omo/contracts": "workspace:*",
    "@omo/host-core": "workspace:*",
    "@omo/pi-runtime": "workspace:*",
    "@pierre/diffs": "^1.4.1",
    "@rive-app/react-webgl2": "^4.33.0",
    "@thesvg/react": "^3.3.3",
    "@tmustier/pi-usage-extension": "^0.9.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.87",
    "ansi-to-react": "^6.1.6",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "latest",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "ultracite": "^7.10.7",
    "vite": "^8.0.0",
    "wait-on": "latest"
  },
  "packageManager": "pnpm@10.34.5",
  "productName": "omo"
}
