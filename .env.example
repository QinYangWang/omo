# Generate with: openssl rand -hex 32
OMO_TOKEN=replace-with-a-long-random-token
OMO_HOST=127.0.0.1
OMO_PORT=5189
OMO_WORKSPACE_ROOTS=/workspace
OMO_DATA_DIR=/data
# OMO_CORS_ORIGINS=https://omo.example.com
# Daemon provider/model overrides. By default the daemon reads Pi's
# settings.json/auth.json and selects a real authenticated model.
# OMO_DAEMON_PROVIDER=kimi-coding
# OMO_DAEMON_MODEL=k3
# OMO_DAEMON_AUTH_PATH=/root/.pi/agent/auth.json
# OMO_DAEMON_FAUX=1  # explicit development-only fake model
